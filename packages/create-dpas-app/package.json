{
  "name": "create-dpas-app",
  "version": "0.6.0",
  "description": "Scaffold a Dual-Plane Agent Stack (DPAS) application: Agent Surface + oRPC Agent + Mastra + assistant-ui.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiseair-srl/create-dpas-app.git",
    "directory": "packages/create-dpas-app"
  },
  "homepage": "https://github.com/Wiseair-srl/create-dpas-app#readme",
  "bugs": "https://github.com/Wiseair-srl/create-dpas-app/issues",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "create-dpas-app": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "template",
    "reference"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./host/transport": {
      "types": "./dist/host/transport.d.ts",
      "import": "./dist/host/transport.js"
    },
    "./host/mastra": {
      "types": "./dist/host/mastra.d.ts",
      "import": "./dist/host/mastra.js"
    },
    "./host/postgres": {
      "types": "./dist/host/postgres.d.ts",
      "import": "./dist/host/postgres.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/sync-template.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "ai": "6.0.191",
    "@mastra/core": "1.53.0",
    "@electric-sql/pglite": "^0.5.4"
  },
  "keywords": [
    "dpas",
    "agent",
    "scaffold",
    "create-app",
    "agent-surface",
    "orpc-agent",
    "mastra",
    "assistant-ui"
  ],
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
