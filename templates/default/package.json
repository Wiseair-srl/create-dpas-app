{
  "name": "dpas-template-default",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"vite\"",
    "dev:server": "cross-env SERVER_PORT=3001 tsx watch server/index.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node build/index.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "view:inspect": "agent-surface inspect",
    "view:snapshot": "agent-surface snapshot",
    "view:check": "agent-surface check",
    "domain:inspect": "orpc-agent inspect",
    "domain:snapshot": "orpc-agent snapshot",
    "domain:check": "orpc-agent check",
    "postinstall": "node scripts/ensure-env.mjs"
  },
  "dependencies": {
    "@agent-surface/core": "^0.23.0",
    "@agent-surface/orpc": "^0.23.0",
    "@agent-surface/react": "^0.23.0",
    "@assistant-ui/react": "^0.15.1",
    "@assistant-ui/react-markdown": "^0.14.8",
    "@fontsource-variable/inter": "^5.2.5",
    "@hono/node-server": "^2.0.12",
    "@mastra/core": "1.53.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc-agent/ai-sdk": "^4.0.0",
    "@orpc-agent/core": "^4.0.0",
    "@orpc-agent/mcp": "^4.0.0",
    "@orpc/client": "^1.14.13",
    "@orpc/server": "^1.14.13",
    "@orpc/tanstack-query": "^1.14.13",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.2",
    "ai": "5.0.221",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.12.33",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.0",
    "react-router-dom": "^7.6.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@agent-surface/cli": "^0.23.0",
    "@agent-surface/compiler": "^0.23.0",
    "@agent-surface/testing": "^0.23.0",
    "@ai-sdk/provider": "^2.0.3",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@orpc-agent/cli": "^4.0.0",
    "@orpc-agent/testing": "^4.0.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "orpcAgent": {
    "entry": "server/runtime.ts",
    "export": "governance"
  }
}
