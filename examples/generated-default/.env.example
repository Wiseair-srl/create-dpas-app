# --- DPAS app configuration -------------------------------------------------
# The app runs in guided demo mode with no configuration at all.
# To enable the live agent, set a model provider and its API key, then restart.

# You can also connect an OpenRouter key from the assistant panel at runtime
# (Model settings). That key lives in server memory for the process only and
# is never written here.

# Model provider: "demo" (default, no key needed), "anthropic", "openai",
# or "openrouter".
MODEL_PROVIDER=demo

# Model id override (optional). Defaults per provider:
#   anthropic  -> anthropic/claude-sonnet-4-5
#   openai     -> openai/gpt-5.1
#   openrouter -> anthropic/claude-sonnet-4.5
# MODEL_ID=

# Provider API keys (only needed for the matching MODEL_PROVIDER).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Connecting a key from the UI is enabled in development and disabled in
# production, because one process shares it with every visitor. Set "true" to
# allow it anyway (single-user deployments), or "false" to always refuse.
# ALLOW_RUNTIME_MODEL_KEY=

# Secret used to sign the local demo session cookie. The default is fine for
# local development; set your own value before deploying anywhere shared.
AUTH_SECRET=dpas-dev-secret-change-me
