# --- DPAS app configuration -------------------------------------------------
# Everything here is optional. The app runs with this file untouched: the
# screens, the governed data layer and the MCP endpoint all work with no keys
# at all. What a key adds is the copilot's ability to actually think.

# Which port the Hono server listens on. In development Vite serves the SPA
# separately and proxies /rpc, /agent, /api and /mcp here.
# PORT=3001

# --- the copilot ------------------------------------------------------------
# Set one of these and restart. With neither, the composer stays inert and says
# so rather than posting a step the server would refuse.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Which model a turn runs on when the browser names none. It must be one the
# server allows (see server/mastra.ts) or the first allowed id wins.
# DEFAULT_MODEL=anthropic/claude-sonnet-4-5

# Override the built-in per-provider allowlists (comma-separated, each
# provider's OWN ids — the provider prefix is added for you).
# ANTHROPIC_MODELS=claude-sonnet-4-5,claude-haiku-4-5
# OPENROUTER_MODELS=anthropic/claude-sonnet-4.5,deepseek/deepseek-chat-v3.1

# --- identity ---------------------------------------------------------------
# Signs the demo session cookie. The default is fine locally; set your own
# before deploying anywhere shared — and replace server/auth.ts with a real
# provider before deploying anywhere at all.
AUTH_SECRET=dpas-dev-secret-change-me
